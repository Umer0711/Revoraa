# =================================================
# Revoraa — Supabase Edge Function Secrets
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# Note: For production, set these via the Supabase CLI:
# supabase secrets set <NAME>=<VALUE>
# =================================================

# ─── Supabase internal ─────────────────────────
# These are automatically provided in production, 
# but may be needed for local edge function testing.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Application Configuration ─────────────────
APP_URL=http://localhost:5173
SENDER_EMAIL="Revoraa <reminders@revoraa.com>"

# ─── API Endpoints (Configurable) ──────────────
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
FCM_API_URL=https://fcm.googleapis.com/fcm/send
RESEND_API_URL=https://api.resend.com/emails

# ─── External Services API Keys ────────────────
RESEND_API_KEY=your-resend-api-key
FCM_SERVER_KEY=your-fcm-server-key

# ─── Razorpay Credentials ─────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
